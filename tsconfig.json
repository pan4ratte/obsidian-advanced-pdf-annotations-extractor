{
  "compilerOptions": {
    // `baseUrl` is deprecated in TypeScript 6 and gone in 7. These two entries
    // are what it was actually doing here: letting src/ files import each other
    // and the locale helpers by package-root path instead of relative walks.
    "paths": {
      "src/*": ["./src/*"],
      "lang/*": ["./lang/*"]
    },
    // ts-jest compiles one test file at a time, and TypeScript 6 refuses to
    // infer an output layout from a single input — without this it reports the
    // common source directory as ./test and stops.
    "rootDir": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    // TypeScript 6 flips the default of `strict` to true. The code was written
    // against the old default, so pin it explicitly rather than let a compiler
    // upgrade change what type-checks. Turning it on is its own piece of work.
    "strict": false,
    "noImplicitAny": false,
    // `node` (node10) is deprecated alongside `baseUrl`. esbuild is the only
    // thing that resolves these imports for the shipped bundle, so `bundler`
    // is the mode that matches reality.
    "moduleResolution": "bundler",
    // Mandatory from TypeScript 6 on; stated so ts-jest stops warning that it
    // is unset and so the moment cast in advancedExtractionModal.ts reads as
    // deliberate rather than as a workaround for an unspecified default.
    "esModuleInterop": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "DOM",
      "ES2020"
    ]
  },
  "include": [
    "**/*.ts"
  ]
}
